# Conexión a PostgreSQL (Render la inyecta desde la base de datos del blueprint)
DATABASE_URL="postgresql://usuario:password@localhost:5432/quiniela"

# Secreto para firmar sesiones (genera uno: openssl rand -hex 32)
SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# Resend para correos reales. Si falta, los correos se imprimen en la consola (modo dev).
RESEND_API_KEY=""
EMAIL_FROM="Quiniela del Bienestar <no-reply@tudominio.mx>"

# Emails de administradores, separados por coma
ADMIN_EMAILS="gilberto.aspros@gmail.com"

# Token de football-data.org para sincronizar marcadores (opcional)
FOOTBALL_DATA_TOKEN=""

# Secreto que autoriza al job externo a llamar POST /api/sync
SYNC_SECRET="cambia-esto-tambien"

# URL pública de la app (para los enlaces de los correos)
APP_URL="http://localhost:3000"
